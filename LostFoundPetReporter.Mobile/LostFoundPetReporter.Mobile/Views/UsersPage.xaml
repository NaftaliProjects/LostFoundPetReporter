<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LostFoundPetReporter.Mobile.Views.UsersPage"
    Title="Users">

    <VerticalStackLayout Padding="20">

        <Label
            Text="Users"
            FontSize="32"
            FontAttributes="Bold"
            Margin="0,0,0,20" />

        <Button
            Text="Refresh Users"
            Clicked="OnRefreshClicked"
            Margin="0,0,0,20" />

        <CollectionView
            ItemsSource="{Binding Users}">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,0,0,10">

                        <VerticalStackLayout>

                            <Label
                                Text="{Binding Name}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Email}"
                                FontSize="14" />

                            <Label
                                Text="{Binding Phone}"
                                FontSize="14" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>