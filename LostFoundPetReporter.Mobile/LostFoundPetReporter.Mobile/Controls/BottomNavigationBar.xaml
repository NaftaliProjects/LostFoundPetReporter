<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="LostFoundPetReporter.Mobile.Controls.BottomNavigationBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid
        Padding="5"
        ColumnDefinitions="*,*,*,*,*"
        HeightRequest="70">

        <Button
            Grid.Column="0"
            Text="Profile"
            Clicked="OnProfileClicked" />

        <Button
            Grid.Column="1"
            Text="Camera"
            Clicked="OnCameraClicked" />

        <Button
            Grid.Column="2"
            Text="Home"
            Clicked="OnHomeClicked" />

        <Button
            Grid.Column="3"
            Text="Map"
            Clicked="OnMapClicked" />

        <Button
            Grid.Column="4"
            Text="Reports"
            Clicked="OnReportsClicked" />

    </Grid>

</ContentView>