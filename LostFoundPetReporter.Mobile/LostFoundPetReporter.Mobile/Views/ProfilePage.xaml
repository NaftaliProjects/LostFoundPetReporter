<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="LostFoundPetReporter.Mobile.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:LostFoundPetReporter.Mobile.Controls"
    Title="Profile">

    <Grid RowDefinitions="*,Auto">

        <!-- ========================= -->
        <!-- Profile Content            -->
        <!-- ========================= -->

        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="30"
                Spacing="15">

                <Label
                    Text="Profile"
                    FontSize="28"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />

                <!-- Name -->

                <Label
                    Text="Name"
                    FontAttributes="Bold" />

                <Entry
                    Text="{Binding CurrentUser.Name}"
                    Placeholder="Enter your name" />

                <!-- Email -->

                <Label
                    Text="Email"
                    FontAttributes="Bold" />

                <Entry
                    Text="{Binding CurrentUser.Email}"
                    Placeholder="Enter your email"
                    Keyboard="Email" />

                <!-- Phone -->

                <Label
                    Text="Phone"
                    FontAttributes="Bold" />

                <Entry
                    Text="{Binding CurrentUser.Phone}"
                    Placeholder="Enter your phone"
                    Keyboard="Telephone" />

                <!-- Update -->

                <Button
                    Text="Update Profile"
                    Command="{Binding UpdateCommand}"
                    Margin="0,20,0,0" />

            </VerticalStackLayout>

        </ScrollView>

        <!-- ========================= -->
        <!-- Bottom Navigation          -->
        <!-- ========================= -->

        <controls:BottomNavigationBar
            Grid.Row="1" />

    </Grid>

</ContentPage>