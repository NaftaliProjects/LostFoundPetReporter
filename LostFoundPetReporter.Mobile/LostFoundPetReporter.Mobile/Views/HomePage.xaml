<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="LostFoundPetReporter.Mobile.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:LostFoundPetReporter.Mobile.Models"
    xmlns:controls="clr-namespace:LostFoundPetReporter.Mobile.Controls"
    Title="Lost Pets">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Page title -->
        <HorizontalStackLayout
            Grid.Row="0"
            Padding="20,20,20,10"
            Spacing="15"
            VerticalOptions="Center">

            <Label
                Text="Lost Pets"
                FontSize="28"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <Button
                Text="Refresh"
                Clicked="OnRefreshClicked"
                VerticalOptions="Center" />

        </HorizontalStackLayout>


        <!-- Lost reports -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding LostReports}"
            Margin="10"
            SelectionMode="Single"
            SelectionChanged="OnLostReportSelected">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20"
                    VerticalOptions="Center">

                    <Label
                        Text="No lost pets found."
                        FontSize="18"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="model:LostReport">

                    <Border
                        Margin="5,8"
                        Padding="12"
                        StrokeShape="RoundRectangle 10">

                        <Grid
                            ColumnDefinitions="90,*"
                            ColumnSpacing="15">

                            <!-- Pet image -->
                            <Border
                                Grid.Column="0"
                                HeightRequest="90"
                                WidthRequest="90"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                VerticalOptions="Center">

                                <Image
                                    Source="dotnet_bot.png"
                                    Aspect="AspectFill" />

                            </Border>


                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="4">

                                                            <!-- Pet -->
                                                            <Label
                                    Text="{Binding PetDescription.Type}"
                                    FontSize="18"
                                    FontAttributes="Bold" />

                                                            <Label
                                    Text="{Binding PetDescription.Breed, StringFormat='Breed: {0}'}"
                                    FontSize="14" />

                                                            <Label
                                    Text="{Binding PetDescription.Colors, StringFormat='Colors: {0}'}"
                                    FontSize="14" />

                                                            <!-- Reporter -->
                                                            <Label
                                    Text="{Binding User.Name, StringFormat='Reporter: {0}'}"
                                    FontSize="14" />

                                                            <Label
                                    Text="{Binding User.Email, StringFormat='Email: {0}'}"
                                    FontSize="13" />

                                                            <Label
                                    Text="{Binding User.Phone, StringFormat='Phone: {0}'}"
                                    FontSize="13" />

                                                            <!-- Report -->
                                                            <Label
                                    Text="{Binding DateTime, StringFormat='Reported: {0:dd/MM/yyyy HH:mm}'}"
                                    FontSize="12" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>


        <!-- Bottom navigation -->
        <controls:BottomNavigationBar
            Grid.Row="2" />

    </Grid>

</ContentPage>