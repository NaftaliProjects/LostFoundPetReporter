<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="LostFoundPetReporter.Mobile.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:LostFoundPetReporter.Mobile.Models"
    xmlns:controls="clr-namespace:LostFoundPetReporter.Mobile.Controls"
    Title="Lost Pets">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Page title -->
        <HorizontalStackLayout
            Grid.Row="0"
            Padding="20,20,20,10"
            Spacing="15"
            VerticalOptions="Center">

                    <Label
                Text="Lost Pets"
                FontSize="28"
                FontAttributes="Bold"
                VerticalOptions="Center" />

                    <Button
                Text="Refresh"
                Clicked="OnRefreshClicked"
                VerticalOptions="Center" />

        </HorizontalStackLayout>

        <!-- Lost reports -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding LostReports}"
            Margin="10"
            SelectionMode="Single"
            SelectionChanged="OnLostReportSelected">
           

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="20"
                    VerticalOptions="Center">

                    <Label
                        Text="No lost pets found."
                        FontSize="18"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:LostReport">

                    <Border Margin="5,8"
                        Padding="12"
                        StrokeShape="RoundRectangle 10">

                        <!-- 2-Column Grid: Left for Image, Right for Details -->
                        <Grid ColumnDefinitions="90, *"
                              ColumnSpacing="15">

                            <!-- Left: Default Pet Image -->
                            <Border 
                                
                                Grid.Column="0" 
                                HeightRequest="90"
                                WidthRequest="90"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Image Source="dotnet_bot.png" Aspect="AspectFill" />
                                   
                            </Border>

                            <!-- Right: Pet & Reporter Info -->
                            <VerticalStackLayout Grid.Column="1"
                                     VerticalOptions="Center"
                                     Spacing="4">

                                <!-- Pet Name -->
                                <Label Text="{Binding PetDescription.Name}"
                                   FontSize="18"
                                   FontAttributes="Bold" /> 

                                <!-- Reporter Name -->
                                <Label Text="{Binding User.Name, StringFormat='Reporter: {0}'}"
                                   FontSize="14"
                                   TextColor="White" />      

                                <!-- Location / Country-City -->
                                <Label Text="{Binding Coordinates, StringFormat='Location: {0}'}"
                                   FontSize="12"
                                   TextColor="White" />

                            </VerticalStackLayout>

                            <controls:BottomNavigationBar
                                Grid.Row="1" />

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        

        <!-- Bottom navigation -->
        <controls:BottomNavigationBar
            Grid.Row="2" />

    </Grid>

</ContentPage>