<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LostFoundPetReporter.Mobile.Views.CreateFoundReportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:LostFoundPetReporter.Mobile.Controls"
    Title="Create Found Report">

    <Grid RowDefinitions="*, Auto">

        <!-- Scrollable Form Content -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="20"
                Spacing="18">

                <Label
                    Text="Create Found Report"
                    FontSize="28"
                    FontAttributes="Bold" />

                <!-- Date / Time -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Date and Time" FontAttributes="Bold" />
                    <DatePicker Date="{Binding Report.dateTime}" />
                    <TimePicker Time="{Binding Report.dateTime}" />
                </VerticalStackLayout>

                <!-- Location -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Location" FontAttributes="Bold" />
                    <Entry Placeholder="Enter coordinates" Text="{Binding Report.Coordinates}" />
                </VerticalStackLayout>

                <!-- Animal -->
                <Label
                    Text="Animal Information"
                    FontSize="22"
                    FontAttributes="Bold"
                    Margin="0,10,0,0" />

                <!-- Animal Type -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Type" FontAttributes="Bold" />
                    <Entry Placeholder="Dog, Cat, Bird..." Text="{Binding PetDescription.Type}" />
                </VerticalStackLayout>

                <!-- Breed -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Breed" FontAttributes="Bold" />
                    <Entry Placeholder="Breed" Text="{Binding PetDescription.Breed}" />
                </VerticalStackLayout>

                <!-- Name -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Name" FontAttributes="Bold" />
                    <Entry Placeholder="Animal's name" Text="{Binding PetDescription.Name}" />
                </VerticalStackLayout>

                <!-- Colors -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Colors" FontAttributes="Bold" />
                    <Entry Placeholder="Brown, black, white..." Text="{Binding PetDescription.Colors}" />
                </VerticalStackLayout>

                <!-- Picture -->
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Picture"
                        FontAttributes="Bold" />

                                    <Button
                        Text="📷 Add Picture"
                        Command="{Binding TakePictureCommand}" />

                                    <Image
                        Source="{Binding PicturePath}"
                        HeightRequest="250"
                        Aspect="AspectFit"
                        IsVisible="{Binding HasPicture}" />

                 </VerticalStackLayout>

                <!-- Create -->
                <Button
                    Text="Create Report"
                    Command="{Binding CreateReportCommand}"
                    Margin="0,10,0,0" />

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Fixed Bottom Navigation Bar -->
        <controls:BottomNavigationBar Grid.Row="1" />

    </Grid>

</ContentPage>