<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="LostFoundPetReporter.Mobile.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:LostFoundPetReporter.Mobile.Models"
    xmlns:converters="clr-namespace:LostFoundPetReporter.Mobile.Converters"
    xmlns:controls="clr-namespace:LostFoundPetReporter.Mobile.Controls"
    Title="Lost Pets">

    <ContentPage.Resources>

        <ResourceDictionary>

            <converters:Base64ToImageSourceConverter
            x:Key="Base64ToImageSourceConverter" />

            <converters:StringNotEmptyConverter
          x:Key="StringNotEmptyConverter" />

            <converters:ListNotEmptyConverter x:Key="ListNotEmptyConverter" />

        </ResourceDictionary>

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Page title -->
        <HorizontalStackLayout
            Grid.Row="0"
            Padding="20,20,20,10"
            Spacing="15"
            VerticalOptions="Center">

            <Label
                Text="Lost Pets"
                FontSize="28"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <Button
                Text="Refresh"
                Clicked="OnRefreshClicked"
                VerticalOptions="Center" />

        </HorizontalStackLayout>


        <!-- Lost reports -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding LostReports}"
            Margin="10"
            SelectionMode="Single"
            SelectionChanged="OnLostReportSelected">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20"
                    VerticalOptions="Center">

                    <Label
                        Text="No lost pets found."
                        FontSize="18"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="model:LostReport">

                    <Border
                        Margin="5,8"
                        Padding="12"
                        StrokeShape="RoundRectangle 10">

                        <VerticalStackLayout Spacing="10">

                            <!-- Photos -->
                            <ScrollView
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">

                                <HorizontalStackLayout
                                    BindableLayout.ItemsSource="{Binding PictureBase64List}"
                                    Spacing="6">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate x:DataType="x:String">

                                            <Border
                                                WidthRequest="90"
                                                HeightRequest="90"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8">

                                                <Image
                                                    Source="{Binding .,
                                                        Converter={StaticResource Base64ToImageSourceConverter}}"
                                                    Aspect="AspectFill" />

                                            </Border>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </HorizontalStackLayout>

                            </ScrollView>


                            <!-- Report information -->
                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding PetDescription.Type}"
                                    FontSize="18"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding PetDescription.Breed, StringFormat='Breed: {0}'}"
                                    FontSize="14" />

                                <Label
                                    Text="{Binding PetDescription.Colors, StringFormat='Colors: {0}'}"
                                    FontSize="14" />

                                <Label
                                    Text="{Binding User.Name, StringFormat='Reporter: {0}'}"
                                    FontSize="14" />

                                <Label
                                    Text="{Binding User.Email, StringFormat='Email: {0}'}"
                                    FontSize="13" />

                                <Label
                                    Text="{Binding User.Phone, StringFormat='Phone: {0}'}"
                                    FontSize="13" />

                                <Label
                                    Text="{Binding DateTime, StringFormat='Reported: {0:dd/MM/yyyy HH:mm}'}"
                                    FontSize="12" />

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>


        <!-- Bottom navigation -->
        <controls:BottomNavigationBar
            Grid.Row="2" />

    </Grid>

</ContentPage>